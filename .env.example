PORT=3037
WS_PATH=/ocpp
BRIDGE_PATH=/bridge
HEARTBEAT_INTERVAL=60
PUBLIC_URL=https://api-dev.pointhub.io

SIMULATOR_MOCK_PASSWORD=simulator-mock-1
PRICE_PER_KWH=500

# Shared-master (preferred): HTTP proxy + bridge events — never share master OCPP URL
EV_HUB_PROXY_URL=https://beta.power-hub.app
EV_HUB_PROVIDER=virtual-server
# Optional: EV_HUB_PLATFORM_KEY=
EV_HUB_BRIDGE_URL=wss://beta.power-hub.app/bridge

CLOUDFLARE_TUNNEL_TOKEN=
