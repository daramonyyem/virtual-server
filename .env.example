EV_HUB_PROVIDER=virtual-server
# EV_HUB_PLATFORM_KEY=
EV_HUB_BRIDGE_URL=ws://localhost:3033/ocpp/bridge
EV_HUB_WS_BASE=ws://localhost:3033/ocpp

